// Prisma Schema — Semana 05
// Dominio: Logística / Almacén

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Recurso secundario — la bodega física de la empresa de logística.
// Relación 1:N — una bodega almacena muchos ítems de inventario.
// ============================================================
model Warehouse {
  id        Int             @id @default(autoincrement())
  code      String          @unique // BOG-01, MED-01... (demuestra P2002)
  name      String
  city      String
  active    Boolean         @default(true)
  items     InventoryItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("warehouses")
}

// ============================================================
// Recurso principal — el ítem de inventario (semanas 01-04).
// ============================================================
model InventoryItem {
  id          Int       @id @default(autoincrement())
  sku         String    @unique // referencia única del catálogo (demuestra P2002)
  name        String
  category    String // validado con z.enum en la capa de schemas
  price       Decimal   @db.Decimal(12, 2)
  stock       Int       @default(0)
  location    String // posición dentro de la bodega: PASILLO-ESTANTE (A-01)
  active      Boolean   @default(true)
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([warehouseId])
  @@map("inventory_items")
}
